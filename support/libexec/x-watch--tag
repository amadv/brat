#!/bin/sh
set -eu

checksum() {
  name="$1"
  shift
  sum="$("$@" 2>/dev/null | cksum | sed -E 's/[^[:digit:]]//g')"
  printf "%s\t%s\n" "$sum" "$name"
}

visit() {
  case "$1" in
    "$BRAT_ROOT"/brat.sh )
      checksum "$1#code" x-show code "$1"
      checksum "$1#prose" x-show prose "$1"
      ;;
    * )
      checksum "$1" cat "$1"
  esac
}

{
  visit "$BRAT_ROOT"/brat.sh
  printf "%s\n" "==="

  while read -r path; do
    case "$path" in
      --- ) printf "%s\n" "$path" ;;
      * ) git -C "$BRAT_ROOT" check-ignore -q "$path" || visit "$path"
    esac
  done
} \
  | awk -f "$LIB"/watch/filter.awk \
  | awk -f "$LIB"/watch/tag.awk
